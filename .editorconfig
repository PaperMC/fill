root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.bat]
end_of_line = crlf

[*.java]
ij_java_generate_final_locals = true
ij_java_generate_final_parameters = true

[*.md]
trim_trailing_whitespace = false

[*.mdx]
trim_trailing_whitespace = false
